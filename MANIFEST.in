include MANIFEST.in
include LICENSE.md
include pyproject.toml
# README.md is required: pyproject.toml sets readme = "README.md".
include README.md

# pyproject.toml's [tool.pixi.workspace.conda-pypi-map] points at this file by relative path,
# so an sdist without it fails `pixi install`.
include conda-pypi-map.json

graft src

# The SAR .onnx model is downloaded on demand (SDS_sar_model), never shipped
recursive-exclude src *.onnx

# graft src would otherwise sweep in compiled files
recursive-exclude * *.py[co]

# setuptools adds tests/ to the sdist by default -- load-bearing, verified
prune tests
